{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "happyx2-d1-backup",
  "main": "src/index.js",
  "compatibility_date": "2026-08-16",
  "vars": {
    "ACCOUNT_ID": "d07e8add7d5d4a068815315d8cc5d733",
    "DATABASE_ID": "c72f3087-b46f-429b-99f2-7c0e177c1699"
  },
  "workflows": [
    {
      "name": "happyx2-d1-backup-workflow",
      "binding": "BACKUP_WORKFLOW",
      "class_name": "D1BackupWorkflow",
      "schedules": ["0 4 * * SUN"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "happyx2-mail-backups"
    }
  ],
  "observability": {
    "enabled": true
  }
}
